# A source archive has the same runtime boundary as the wheel. Tests, research,
# operational data and development evidence stay in the checkout.
global-exclude *
include pyproject.toml MANIFEST.in README.md LICENSE
recursive-include task_relay *.py
include task_relay/assets/*.png
include task_relay/assets/*.html
include task_relay/assets/*.css
include task_relay/assets/*.js
include task_relay/assets/perplexity-extension.json
recursive-include task_relay/assets/vendor *.js *.LICENSE *.txt
include task_relay/assets/requirements-claude*.txt
include task_relay/assets/macos/*.swift
include orchestrator/*.py
include orchestrator/*.rb
global-exclude *.pyc

include task_relay/assets/desktop-request-limits.json
include task_relay/assets/node-icons/*.svg
include task_relay/assets/job-templates/*.json
include task_relay/assets/job-templates/*.zip
include orchestrator/*.schema.json
include task_relay/assets/node-icons/*.png
include task_relay/assets/node-icons/*.md
