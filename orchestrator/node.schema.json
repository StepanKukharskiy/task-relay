{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:task-relay:node:3",
  "title": "Relay operation node",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        3
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "artifact": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "artifact"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "task": {
                "type": "string",
                "minLength": 1
              },
              "output": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "task",
              "output"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  },
                  {
                    "type": "object"
                  },
                  {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            "required": [
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "workflow": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "workflow"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "media_type",
          "purpose"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "input_definitions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "object",
              "array",
              "null",
              "artifact"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "default": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "object"
              },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            ]
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "label",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "codex",
            "gemini",
            "openai",
            "qwen",
            "deepseek",
            "openrouter"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "reasoning": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max",
            "ultra"
          ]
        }
      },
      "required": [
        "provider",
        "id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "objective",
    "operation",
    "inputs"
  ],
  "additionalProperties": false
}
