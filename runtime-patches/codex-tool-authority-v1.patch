+//! Relay startup ceiling. It restricts tools; existing approvals/sandbox remain.
+use codex_extension_api::{ToolName, ToolPolicy};
+use codex_protocol::dynamic_tools::DynamicToolSpec;
+use serde::Deserialize;
+use std::collections::BTreeSet;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Authority {
+    version: u32,
+    dynamic_tools: Vec<String>,
+    hosted_tools: Vec<String>,
+}
+
+pub(crate) fn compile(value: serde_json::Value, dynamic: &[DynamicToolSpec]) -> Result<ToolPolicy, String> {
+    let authority: Authority = serde_json::from_value(value).map_err(|e| format!("Invalid Relay authority: {e}"))?;
+    if authority.version != 1 { return Err("Unsupported Relay authority version".into()); }
+    let mut declared = BTreeSet::new();
+    for tool in dynamic {
+        let DynamicToolSpec::Function(function) = tool else { return Err("Relay requires flat dynamic declarations".into()); };
+        if function.name.is_empty() || !declared.insert(function.name.clone()) {
+            return Err("Empty or duplicate dynamic tool declaration".into());
+        }
+    }
+    let allowed: BTreeSet<_> = authority.dynamic_tools.iter().cloned().collect();
+    if allowed.len() != authority.dynamic_tools.len() || allowed != declared {
+        return Err("Relay authority differs from dynamic declarations".into());
+    }
+    if authority.hosted_tools.len() > 1 || authority.hosted_tools.iter().any(|name| name != "web_search")
+        || authority.hosted_tools.iter().any(|name| declared.contains(name)) {
+        return Err("Unsupported or ambiguous hosted authority".into());
+    }
+    let mut names: Vec<ToolName> = authority.dynamic_tools.into_iter().map(ToolName::plain).collect();
+    if !authority.hosted_tools.is_empty() {
+        names.push(ToolName::plain("web_search"));
+        names.push(ToolName::namespaced("web", "run"));
+    }
+    Ok(ToolPolicy { allowed_tools: Some(names), expose_additional_permissions: false, ..Default::default() })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn relay_gate_empty_and_hosted_ceiling() {
+        let empty = compile(serde_json::json!({"version":1,"dynamic_tools":[],"hosted_tools":[]}), &[]).unwrap();
+        for name in ["list_mcp_resources", "exec_command", "web_search", "future_tool"] {
+            assert!(!empty.allows(&ToolName::plain(name)));
+        }
+        let search = compile(serde_json::json!({"version":1,"dynamic_tools":[],"hosted_tools":["web_search"]}), &[]).unwrap();
+        assert!(search.allows(&ToolName::plain("web_search")));
+        assert!(!search.allows(&ToolName::new(Some("ambient".into()), "web_search".into())));
+    }
+    #[test]
+    fn relay_gate_malformed_authority_cannot_expand() {
+        for value in [serde_json::json!({}), serde_json::json!({"version":2,"dynamic_tools":[],"hosted_tools":[]}),
+            serde_json::json!({"version":1,"dynamic_tools":["shell_command"],"hosted_tools":[]}),
+            serde_json::json!({"version":1,"dynamic_tools":[],"hosted_tools":["image_generation"]}),
+            serde_json::json!({"version":1,"dynamic_tools":[],"hosted_tools":[],"allow_all":true})] {
+            assert!(compile(value,&[]).is_err());
+        }
+    }
+}
