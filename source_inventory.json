{
  "version": 2,
  "groups": [
    {
      "kind": "chrome-extension",
      "release": false,
      "patterns": [
        "extensions/chrome/*.json",
        "extensions/chrome/*.js",
        "extensions/chrome/*.html",
        "extensions/chrome/*.css",
        "extensions/chrome/*.png",
        "extensions/chrome/icons/*.png"
      ]
    },
    {
      "kind": "chatgpt-plugin",
      "release": false,
      "patterns": [
        "plugins/relay/*.json",
        "plugins/relay/README.md",
        "plugins/relay/assets/*.png",
        "plugins/relay/skills/*/SKILL.md",
        "plugins/relay/skills/*/references/*.md",
        "plugins/relay/hosted/*.json",
        "plugins/relay/hosted/README.md",
        "plugins/relay/hosted/skills/*/SKILL.md",
        "plugins/relay/hosted/skills/*/references/*.md",
        "plugins/relay/server/Dockerfile",
        "plugins/relay/server/requirements.txt",
        "plugins/relay/server/railway.json",
        "plugins/relay/server/start.py",
        "plugins/relay/server/README.md"
      ]
    },
    {
      "kind": "website",
      "release": false,
      "patterns": [
        "website/README.md",
        "website/package.json",
        "website/server.mjs",
        "website/Dockerfile",
        "website/.dockerignore",
        "website/.railwayignore",
        "website/railway.json",
        "website/public/*.html",
        "website/public/*.css",
        "website/public/*.png",
        "website/public/llms.txt",
        "website/public/robots.txt",
        "website/public/sitemap.xml",
        "website/public/guides/*.html",
        "website/public/chatgpt/*.html",
        "website/public/guides/*.css",
        "website/public/guides/assets/file-recipes.py",
        "website/public/guides/assets/invoice-sample.zip",
        "website/public/guides/assets/csv-sample.zip",
        "website/public/guides/assets/barcelona-pre-schematic-v1.pptx",
        "website/public/guides/assets/architecture-preview.png",
        "website/public/guides/assets/architecture-sources.json",
        "website/public/guides/assets/architecture-request.txt",
        "website/public/guides/assets/architecture-request-v2.txt",
        "website/public/guides/assets/complaint-research-request.txt",
        "website/fetch-downloads.mjs",
        "website/downloads.json",
        "website/releases.mjs",
        "website/release-fallback.json",
        "website/funnel.mjs",
        "website/summarize-funnel.mjs",
        "website/public/skills/*.html",
        "website/public/skills/*.css",
        "website/public/skills/assets/*.png",
        "website/public/skills/assets/*.json",
        "website/public/skills/assets/*.md",
        "website/public/skills/assets/*.zip",
        "website/public/skills/assets/*.sha256",
        "website/public/chrome/*.html",
        "website/public/skills/assets/scripts/update-report.mjs",
        "website/public/skills/assets/scripts/attach-chart-workbooks.py",
        "website/public/skills/assets/references/codex-runtime.md"
      ]
    },
    {
      "kind": "license",
      "release": true,
      "patterns": [
        "LICENSE"
      ]
    },
    {
      "kind": "application",
      "release": true,
      "patterns": [
        "task_relay/*.py",
        "orchestrator/*.py",
        "orchestrator/*.rb",
        "orchestrator/*.schema.json"
      ],
      "exclude": [
        "test_*.py"
      ]
    },
    {
      "kind": "optional-macos",
      "release": false,
      "patterns": [
        "*.command",
        "messages_service/*.swift"
      ]
    },
    {
      "kind": "desktop-build",
      "release": false,
      "patterns": [
        "desktop/README.md",
        "desktop/package.json",
        "desktop/package-lock.json",
        "desktop/scripts/*",
        "desktop/src-tauri/Cargo.toml",
        "desktop/src-tauri/Cargo.lock",
        "desktop/src-tauri/build.rs",
        "desktop/src-tauri/tauri.conf.json",
        "desktop/src-tauri/Info.plist",
        "desktop/src-tauri/src/*.rs",
        "desktop/src-tauri/capabilities/*.json",
        "desktop/src-tauri/icons/*.png",
        "desktop/src-tauri/icons/*.icns",
        "desktop/src-tauri/icons/*.ico"
      ]
    },
    {
      "kind": "packaged-assets",
      "release": true,
      "patterns": [
        "task_relay/assets/*.png",
        "task_relay/assets/*.html",
        "task_relay/assets/*.css",
        "task_relay/assets/*.js",
        "task_relay/assets/perplexity-extension.json",
        "task_relay/assets/desktop-request-limits.json",
        "task_relay/assets/vendor/*.js",
        "task_relay/assets/vendor/*.LICENSE",
        "task_relay/assets/vendor/*.txt",
        "task_relay/assets/*.txt",
        "task_relay/assets/macos/*.swift",
        "task_relay/assets/node-icons/*.svg",
        "task_relay/assets/job-templates/*.json",
        "task_relay/assets/job-templates/*.zip",
        "task_relay/assets/node-icons/*.png",
        "task_relay/assets/node-icons/*.md"
      ]
    },
    {
      "kind": "dependencies",
      "release": true,
      "patterns": [
        "requirements-claude.txt",
        "requirements-claude-lock.txt"
      ]
    },
    {
      "kind": "tests",
      "release": false,
      "patterns": [
        "tests/*.py",
        "tests/fixtures/*.sql",
        "tests/*.cjs",
        "tests/*.html",
        "tests/fixtures/*.json"
      ]
    },
    {
      "kind": "research-code",
      "release": false,
      "patterns": [
        "learning/*.py",
        "experiments/o08/*.py",
        "experiments/proposal_review/*.py"
      ]
    },
    {
      "kind": "maintenance",
      "release": false,
      "patterns": [
        "scripts/*.py",
        "runtime-patches/*.patch",
        "install.sh",
        "source_inventory.json",
        ".gitignore",
        "pyproject.toml",
        "MANIFEST.in",
        ".gitattributes",
        ".github/workflows/*.yml"
      ]
    },
    {
      "kind": "documentation",
      "release": false,
