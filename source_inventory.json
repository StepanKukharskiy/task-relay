{
  "version": 2,
  "groups": [
    {
      "kind": "website",
      "release": false,
      "patterns": [
        "website/README.md",
        "website/package.json",
        "website/server.mjs",
        "website/Dockerfile",
        "website/.dockerignore",
        "website/.railwayignore",
        "website/railway.json",
        "website/public/*.html",
        "website/public/*.css",
        "website/public/*.png",
        "website/public/llms.txt",
        "website/public/robots.txt",
        "website/public/sitemap.xml",
        "website/public/guides/*.html",
        "website/public/guides/*.css",
        "website/public/guides/assets/file-recipes.py",
        "website/public/guides/assets/invoice-sample.zip",
        "website/public/guides/assets/csv-sample.zip",
        "website/public/guides/assets/barcelona-pre-schematic-v1.pptx",
        "website/public/guides/assets/architecture-preview.png",
        "website/public/guides/assets/architecture-sources.json",
        "website/public/guides/assets/architecture-request.txt",
        "website/public/guides/assets/architecture-request-v2.txt",
        "website/public/guides/assets/complaint-research-request.txt"
      ]
    },
    {
      "kind": "license",
      "release": true,
      "patterns": [
        "LICENSE"
      ]
    },
    {
      "kind": "application",
      "release": true,
      "patterns": [
        "*.py",
        "task_relay/*.py",
        "orchestrator/*.py"
      ],
      "exclude": [
        "test_*.py"
      ]
    },
    {
      "kind": "optional-macos",
      "release": false,
      "patterns": [
        "*.command",
        "messages_service/*.swift"
      ]
    },
    {
      "kind": "desktop-build",
      "release": false,
      "patterns": [
        "desktop/README.md",
        "desktop/package.json",
        "desktop/package-lock.json",
        "desktop/scripts/*",
        "desktop/src-tauri/Cargo.toml",
        "desktop/src-tauri/Cargo.lock",
        "desktop/src-tauri/build.rs",
        "desktop/src-tauri/tauri.conf.json",
        "desktop/src-tauri/Info.plist",
        "desktop/src-tauri/src/*.rs",
        "desktop/src-tauri/capabilities/*.json",
        "desktop/src-tauri/icons/*.png",
        "desktop/src-tauri/icons/*.icns",
        "desktop/src-tauri/icons/*.ico"
      ]
    },
    {
      "kind": "packaged-assets",
      "release": true,
      "patterns": [
        "task_relay/assets/*.png",
        "task_relay/assets/*.html",
        "task_relay/assets/*.css",
        "task_relay/assets/*.js",
        "task_relay/assets/perplexity-extension.json",
        "task_relay/assets/vendor/*.js",
        "task_relay/assets/vendor/*.LICENSE",
        "task_relay/assets/vendor/*.txt",
        "task_relay/assets/*.txt",
        "task_relay/assets/macos/*.swift"
      ]
    },
    {
      "kind": "dependencies",
      "release": true,
      "patterns": [
        "requirements-claude.txt",
        "requirements-claude-lock.txt"
      ]
    },
    {
      "kind": "tests",
      "release": false,
      "patterns": [
        "tests/*.py",
        "tests/fixtures/*.sql",
        "tests/*.cjs"
      ]
    },
    {
      "kind": "research-code",
      "release": false,
      "patterns": [
        "learning/*.py",
        "experiments/o08/*.py",
        "experiments/proposal_review/*.py"
      ]
    },
    {
      "kind": "maintenance",
      "release": false,
      "patterns": [
        "scripts/*.py",
        "install.sh",
        "source_inventory.json",
        ".gitignore",
        "pyproject.toml",
        "MANIFEST.in",
        ".gitattributes",
        ".github/workflows/*.yml"
      ]
    },
    {
      "kind": "documentation",
      "release": false,
      "patterns": [
        "AGENTS.md",
        "README.md",
        "ROADMAP.md",
        "CHANGELOG.md",
        "docs/architecture-pipeline-benchmark.md",
        "docs/artifact-dependencies.md",
        "docs/artifact-replacements.md",
        "docs/blender-animation.md",
        "docs/blender-qualification.md",
        "docs/capability-registry.md",
        "docs/continuity-experiment.md",
        "docs/conversation-handoffs.md",
        "docs/execution-providers.md",
        "docs/host-adapters.md",
        "docs/linked-workflows.md",
        "docs/llm-orchestration.md",
        "docs/local-applications.md",
        "docs/messages-pilot.md",
        "docs/mixed-execution.md",
        "docs/native-qualification.md",
        "docs/natural-language-routing.md",
        "docs/new-pipeline-planning.md",
        "docs/orchestrator-web.md",
        "docs/packaging.md",
        "docs/presentations.md",
        "docs/media-workflows.md",
        "docs/project-tasks-and-starters.md",
        "docs/request-derived-pipelines.md",
        "docs/reusable-procedures.md",
        "docs/automation-opportunities.md",
        "docs/capability-workers.md",
        "docs/shared-code-workers.md",
        "docs/onboarding.md",
        "docs/updates.md",
        "docs/app-updates.md",
        "docs/release-notes.md",
        "docs/path-configuration.md",
        "docs/platform-architecture.md",
        "docs/production-selections.md",
        "docs/project-structure.md",
        "docs/reference-collection.md",
        "docs/rhino.md",
        "docs/shared-storage.md",
        "docs/usage-tracking.md",
        "docs/worker-runtime.md",
        "docs/workflow-observer.md",
        "docs/publication.md",
        "experiments/proposal_review/README.md",
        "docs/perplexity-browser.md",
        "docs/general-browser.md",
        "docs/account-sites.md",
        "docs/desktop-browser.md"
      ]
    }
  ],
  "excluded_roots": [
    ".git",
    ".agents",
    ".codex",
    "private",
    "projects",
    "generated",
    "outputs",
    "output",
    "Messages Relay.app",
    "__pycache__",
    ".venv",
    "node_modules",
    "dist",
    "build"
  ],
  "maintained_exceptions": [],
  "release_note": "Wheel and source archive contain only the explicit runtime packages, compatibility modules and bundled assets defined in pyproject.toml and MANIFEST.in. Tests, research, operational data and build evidence remain outside distributions."
}
