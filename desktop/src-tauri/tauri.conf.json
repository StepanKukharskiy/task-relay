{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task Relay",
  "version": "0.13.155",
  "identifier": "com.taskrelay.desktop",
  "build": {
    "beforeDevCommand": "npm run sync-ui",
    "beforeBuildCommand": "npm run sync-ui",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Task Relay",
        "width": 1040,
        "height": 760,
        "minWidth": 780,
        "minHeight": 560
      }
    ]
  },
  "bundle": {
    "active": true,
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist"
    },
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": [
      "resources/runtime/**/*"
    ]
  }
}
